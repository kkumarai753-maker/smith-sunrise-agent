function read_(){var state=defaults_(),meta=sheet_('_State',['Key','JSON']);if(meta.getLastRow()>1)meta.getRange(2,1,meta.getLastRow()-1,2).getValues().forEach(function(r){try{state[r[0]]=JSON.parse(r[1]);}catch(e){throw new Error('State data is invalid: '+r[0]);}});var seenSheet=sheet_('_Seen',['Domain','Reviewed at','Reason']);state.seen=seenSheet.getLastRow()>1?seenSheet.getRange(2,1,seenSheet.getLastRow()-1,3).getValues().map(function(r){return {website:r[0],at:r[1],reason:r[2]};}):[];var ls=sheet_('Leads',HEADERS);if(ls.getLastRow()>1)state.leads=ls.getRange(2,1,ls.getLastRow()-1,HEADERS.length).getValues().filter(function(r){return r[26];}).map(function(r){var l=JSON.parse(r[26]);l.owner=String(r[15]||'');l.remark=String(r[16]||'');l.status=String(r[17]||'New');l.nextFollowUp=String(r[18]||'');return l;});if(state.template.outreachVersion!==2){var priorVersion=state.template.version||1;state.template=defaults_().template;state.template.version=priorVersion+1;}state.settings.dailyTarget=30;return state;}
function leadRow_(l){return [l.id,l.business,l.person,l.phone,l.email,l.website,l.category,l.city,l.zone,l.score,l.scoreReason,(l.findings||[]).map(function(f){return f.title+' — '+f.url;}).join('\n'),(l.evidence||[]).map(function(e){return e.url;}).join('\n'),l.emailStatus,l.sentAt||'',l.owner,l.remark,l.status,l.nextFollowUp||'',l.source,l.contactSource,l.createdAt,l.evidenceStatus||'Pending',l.unsubscribed?'Yes':'No',l.cityVerified?'Yes':'No',l.zoneVerified?'Yes':'Search segment only',JSON.stringify(l)].map(clean_);}
function save_(s,before){var ls=sheet_('Leads',HEADERS),old={};before.leads.forEach(function(l,i){old[l.id]={l:l,row:i+2};});s.leads.forEach(function(l){var prev=old[l.id];if(!prev)ls.appendRow(leadRow_(l));else if(JSON.stringify(prev.l)!==JSON.stringify(l))ls.getRange(prev.row,1,1,HEADERS.length).setValues([leadRow_(l)]);});var newSeen=s.seen.slice(before.seen.length);if(newSeen.length){var seenSheet=sheet_('_Seen',['Domain','Reviewed at','Reason']);seenSheet.getRange(seenSheet.getLastRow()+1,1,newSeen.length,3).setValues(newSeen.map(function(x){return [clean_(x.website),clean_(x.at),clean_(x.reason)];}));}var meta=sheet_('_State',['Key','JSON']),rows=Object.keys(s).filter(function(k){return k!=='leads'&&k!=='seen';}).map(function(k){return [k,JSON.stringify(s[k])];});meta.getRange(2,1,Math.max(rows.length,meta.getLastRow()-1),2).clearContent();meta.getRange(2,1,rows.length,2).setValues(rows);var runs=sheet_('Runs',['Date IST','Status','New qualified leads','Target','Queries','Candidates reviewed','Reason','Started','Finished']);if(runs.getLastRow()>1)runs.getRange(2,1,runs.getLastRow()-1,9).clearContent();if(s.runs.length)runs.getRange(2,1,s.runs.length,9).setValues(s.runs.map(function(r){return [r.day,r.status,r.count,r.target,r.queries,r.reviewed,r.reason||'',r.startedAt,r.finishedAt||''];}));}
function event_(s,message){s.events.unshift({at:new Date().toISOString(),message:message});s.events=s.events.slice(0,100);}
function domain_(v){return String(v||'').toLowerCase().replace(/^https?:\/\//,'').split('/')[0].replace(/^www\./,'').replace(/\.$/,'');}
function phone_(v){var n=String(v||'').replace(/\D/g,'');return n.length===10?'91'+n:n;}
function email_(v){return String(v||'').trim().toLowerCase();}
function duplicate_(a,b){return !!(a.website&&b.website&&domain_(a.website)===domain_(b.website)||a.email&&b.email&&email_(a.email)===email_(b.email)||a.phone&&b.phone&&phone_(a.phone)===phone_(b.phone)||a.business&&b.business&&a.business.toLowerCase().replace(/[^a-z0-9]/g,'')===b.business.toLowerCase().replace(/[^a-z0-9]/g,'')&&a.city===b.city);}
function advance_(s){var p=s.planner,x=s.settings;p.offset=0;p.categoryIndex++;if(p.categoryIndex>=x.categories.length){p.categoryIndex=0;p.completed.push(x.cities[p.cityIndex]+':'+x.zones[p.zoneIndex]+':'+p.cycle);p.completed=p.completed.slice(-100);p.zoneIndex++;}if(p.zoneIndex>=x.zones.length){p.zoneIndex=0;p.cityIndex++;}if(p.cityIndex>=x.cities.length){p.cityIndex=0;p.cycle++;}}
function doPost(e){var lock=LockService.getScriptLock();try{var req=JSON.parse(e.postData.contents),secret=PropertiesService.getScriptProperties().getProperty('SMITH_SECRET');if(!secret||secret.length<32||req.secret!==secret)throw new Error('Unauthorized bridge request.');lock.waitLock(20000);var s=read_(),before=JSON.parse(JSON.stringify(s)),data=action_(s,req.action,req.payload||{});if(req.action!=='snapshot'&&req.action!=='evidence-get')save_(s,before);return json_({ok:true,data:data});}catch(err){return json_({ok:false,error:err.message});}finally{if(lock.hasLock())lock.releaseLock();}}
function json_(data){return ContentService.createTextOutput(JSON.stringify(data)).setMimeType(ContentService.MimeType.JSON);}
