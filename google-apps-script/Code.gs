function defaults_(){return {leads:[],runs:[],events:[],candidates:[],seen:[],sequence:0,settings:{dailyTarget:30,active:false,cities:['Nagpur','Pune','Mumbai','Hyderabad','Bengaluru','Delhi'],zones:['East','West','North','South'],categories:['Health & wellness','Education','FMCG','IT & technology','Travel & hospitality','Manufacturing','Professional services'],maxQueries:40,maxCandidates:240},planner:{cityIndex:0,zoneIndex:0,categoryIndex:0,offset:0,completed:[],cycle:1},template:{subject:"A brighter digital presence for your business",body:"Hello Sir/Ma’am,\n\nWe’re Sunrise Tech Origin, a tech solutions and social media marketing agency. We help businesses grow online with professional websites, regular social media content and SEO—at reasonable rates.\n\nPlease see the attached pictures for a quick introduction to our services. May we arrange a short call to discuss your business goals?\n\nSunrise Tech Origin\n+91 8766803990 | info@sunrisetechorigin.com | sunrisetechorigin.com\n\nNot interested? Unsubscribe: {{unsubscribe}}",version:2,outreachVersion:2,approvedHash:"",approvedAt:"",autoSend:false}};}
