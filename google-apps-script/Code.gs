var HEADERS = ['Lead ID','Business name','Contact person','Phone','Email','Website','Category','City','Search zone','Potential /10','Score reason','Findings','Evidence links','Email status','Email sent at','Sales owner','Sales remark','Sales status','Next follow-up','Source URL','Contact source','Found at','Evidence status','Unsubscribed','City verified','Zone verified','_record'];
