{
  "version": 2,
  "outputDirectory": "public",
  "functions": {
    "api/index.mjs": {
      "maxDuration": 180,
      "includeFiles": [
        "public/email-assets/**",
        "views/**"
      ]
    }
  },
  "rewrites": [
    {
      "source": "/",
      "destination": "/api/index?action=workspace"
    },
    {
      "source": "/index.html",
      "destination": "/api/index?action=workspace"
    },
    {
      "source": "/api/worker",
      "destination": "/api/index?action=worker"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src 'self'; object-src 'none'; base-uri 'self'; frame-ancestors 'none'; form-action 'self'"
        }
      ]
    }
  ]
}
